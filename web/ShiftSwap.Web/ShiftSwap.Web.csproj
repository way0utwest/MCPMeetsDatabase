<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>shiftswap-web-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entra ID sign-in and token acquisition for the DAB API scope -->
    <PackageReference Include="Microsoft.Identity.Web" Version="3.*" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="3.*" />

    <!-- Agent: model client + tool calling -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="9.*-*" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.*" />
    <PackageReference Include="Azure.Identity" Version="1.*" />

    <!-- MCP client (official C# SDK, preview). Check the README for the current API surface. -->
    <PackageReference Include="ModelContextProtocol" Version="0.*-*" />
  </ItemGroup>

</Project>

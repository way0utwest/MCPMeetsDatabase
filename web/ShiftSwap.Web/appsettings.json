{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<shiftswap-web-client-id>",
    "ClientSecret": "<set via user-secrets or Key Vault>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Dab": {
    "BaseUrl": "http://localhost:5000",
    "Scope": "api://<shiftswap-api-client-id>/access_as_user"
  },
  "AzureOpenAI": {
    "Endpoint": "https://<your-resource>.openai.azure.com/",
    "Deployment": "gpt-4o",
    "ApiKey": ""
  },
  "Dev": {
    "FakeEmail": ""
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "ShiftSwap": "Debug" }
  },
  "AllowedHosts": "*"
}
